programa
{
	
	funcao inicio()
	{
		cadeia nome
		real salario

		escreva("Qual é o seu nome? ")
		leia(nome)
		escreva("Qual é o seu saláro? ")
		leia(salario)
		escreva("O seu nome é " + nome +", e o seu salário é de:"+salario+" R$")
	}
}
